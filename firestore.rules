rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn()
        && userDoc().data.role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return isSignedIn()
        && (
          userDoc().data.role == 'super_admin'
          || isBootstrapSuperAdmin()
        );
    }

    function adminRoleChangeAllowed(userId) {
      let newRole = request.resource.data.role;
      let oldRole = resource.data.role;
      return validUserRole(newRole)
        && (
          isSuperAdmin()
          || (
            isAdmin()
            && newRole in ['user', 'admin']
            && oldRole != 'super_admin'
            && request.auth.uid != userId
          )
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasPhone(data) {
      return data.phone is string && data.phone.size() >= 9;
    }

    function isBootstrapSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'salimahmed110077@gmail.com';
    }

    function validUserRole(role) {
      return role in ['user', 'admin', 'super_admin'];
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && validUserRole(request.resource.data.role)
        && (
          request.resource.data.role == 'user'
          || (isBootstrapSuperAdmin() && request.resource.data.role == 'super_admin')
        );
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow update: if isOwner(userId)
        && isBootstrapSuperAdmin()
        && request.resource.data.role == 'super_admin';
      allow update: if isAdmin()
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || adminRoleChangeAllowed(userId)
        );
      allow delete: if isSuperAdmin();
    }

    // ─── Companies ─────────────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── Leads (public create for marketing forms) ───────────────────────────
    match /leads/{leadId} {
      allow create: if hasPhone(request.resource.data)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.source is string
        && request.resource.data.status is string
        && request.resource.data.isArchived == false;
      allow read, update, delete: if isAdmin();
    }

    function validTimeString(t) {
      return t is string && t.matches('^[0-9]{2}:[0-9]{2}$');
    }

    // ─── Appointments (guest demo booking) ───────────────────────────────────
    match /appointments/{appointmentId} {
      allow create: if hasPhone(request.resource.data)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validTimeString(request.resource.data.startTime)
        && validTimeString(request.resource.data.endTime)
        && request.resource.data.status == 'pending'
        && request.resource.data.demoType is string
        && request.resource.data.preferredContact is string;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ─── One active demo per phone / signed-in user ────────────────────────────
    match /booking_locks/{lockId} {
      allow read: if true;
      allow create: if request.resource.data.appointmentId is string
        && hasPhone(request.resource.data)
        && request.resource.data.phone is string;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ─── Slot locks (atomic booking; created in same transaction as appointment) ─
    match /booked_slots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.date is string
        && validTimeString(request.resource.data.startTime)
        && validTimeString(request.resource.data.endTime)
        && request.resource.data.appointmentId is string;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ─── CMS content (public read published, admin write) ────────────────────
    match /content/{contentId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /faqs/{id} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // ─── Newsletter & contact forms ──────────────────────────────────────────
    match /newsletter_subscribers/{id} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*\\..*');
      allow read, update, delete: if isAdmin();
    }

    match /contact_form_submissions/{id} {
      allow create: if request.resource.data.name is string
        && request.resource.data.message is string
        && (hasPhone(request.resource.data) || request.resource.data.email is string);
      allow read, update, delete: if isAdmin();
    }

    // ─── Schedule config ─────────────────────────────────────────────────────
    match /schedule_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Activity logs (admin only) ──────────────────────────────────────────
    match /activity_logs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
